# Backend environment variables (Spring Boot reads these from the process env).
#
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit secrets. To run locally use ./run.sh (sources .env, then mvnw).
#
# Admin seed. No password is committed: leave ADMIN_PASSWORD empty and a random
# one is generated and printed once at boot, or set your own (min 8 characters).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
#
# Password recovery. While set, this overwrites the stored admin password on
# every boot — set it, redeploy, log in, then unset it again.
# ADMIN_RESET_PASSWORD=
#
# OpenAI-assisted writing helpers (gallery descriptions + article drafts).
# Leave empty to disable AI endpoints (they return 503). Admin-only, stateless.
OPENAI_API_KEY=
